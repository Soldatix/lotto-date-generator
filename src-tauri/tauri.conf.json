{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Date Lotto Generator",
  "version": "1.0.1",
  "identifier": "org.appsandgames.datelottogenerator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Date Lotto Generator",
        "width": 1100,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
